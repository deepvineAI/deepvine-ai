---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Pillars from '../components/Pillars.astro';
import VideoSection from '../components/VideoSection.astro';
import MemoryLayer from '../components/MemoryLayer.astro';
import Difference from '../components/Difference.astro';
import SecurityRow from '../components/SecurityRow.astro';
import CtaBand from '../components/CtaBand.astro';
import { organization } from '../data/schema';
---
<Base
  title="Deepvine.AI | Own the Memory. Swap the Models."
  description="Private AI memory your firm owns: years of history backfilled, updated daily, answerable in Slack with sources. Works with any model. For law firms, RIAs, and CPA firms."
  path="/"
  ogTitle="Deepvine.AI | Own the memory. Swap the models."
  ogDescription="Company memory, privately owned. Years of history backfilled, updated daily, answerable in Slack with sources. Runs where you control it and works with any model."
  schema={[organization]}
  preloadHero
>
  <Hero />
  <Pillars />
  <VideoSection />
  <MemoryLayer />
  <Difference />
  <SecurityRow />
  <CtaBand />
</Base>
