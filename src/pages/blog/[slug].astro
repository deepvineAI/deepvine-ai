---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { team } from '../../data/team';
import { SITE, organization } from '../../data/schema';
import { fmtDate, readingTime } from '../../data/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const path = `/blog/${post.id}/`;
const author = team.find((t) => t.name === d.author) || team[0];

// Structured data: carry over the verbatim graph when present; otherwise generate it from frontmatter.
const generated = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    { "@type": "BreadcrumbList", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE}/` },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${SITE}/blog/` },
      { "@type": "ListItem", "position": 3, "name": d.title, "item": `${SITE}${path}` } ] },
    { "@type": "BlogPosting", "@id": `${SITE}${path}#article`, "headline": d.title, "description": d.description,
      "datePublished": d.date, "dateModified": d.updated || d.date, "author": { "@type": "Person", "name": d.author },
      "publisher": { "@id": "https://www.deepvine.ai/#organization" }, "mainEntityOfPage": `${SITE}${path}`,
      "image": `${SITE}/og-home.png`, "articleSection": d.section, "keywords": d.keywords.join(', ') },
    ...(d.faq?.length ? [{ "@type": "FAQPage", "mainEntity": d.faq.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }] : []),
  ],
};
const schema = d.schema ? [d.schema] : [generated];
---
<Base title={`${d.title} | Deepvine.AI`} description={d.description} path={path} ogType="article" publishedTime={d.date} modifiedTime={d.updated} schema={schema}>
  <article class="post">
    <header class="post__head">
      <div class="container post__headinner">
        <Breadcrumbs items={[{ label: 'Blog', href: '/blog/' }, { label: d.section || 'Article' }]} />
        {d.section && <p class="eyebrow">{d.section}</p>}
        <h1>{d.title}</h1>
        <p class="lead">{d.description}</p>
        <div class="byline">
          {author.photo ? <img src={author.photo} width="44" height="44" alt="" /> : <span class="byline__initials">{author.initials}</span>}
          <div>
            <strong>{author.name}</strong>
            <span>{fmtDate(d.date)} · {d.readingTime || readingTime(post.body)}</span>
          </div>
        </div>
      </div>
    </header>

    <div class="container post__body">
      <div class="prose">
        <Content />
      </div>
    </div>

    <Faq items={d.faq || []} lead="The questions we hear most on this topic, answered plainly." />

    <section class="authorbox">
      <div class="container">
        <div class="authorbox__card">
          {author.photo ? <img src={author.photo} width="72" height="72" alt={author.name} loading="lazy" /> : <span class="byline__initials">{author.initials}</span>}
          <div>
            <p class="eyebrow">Written by</p>
            <h3>{author.name}</h3>
            <p>{author.short}</p>
          </div>
        </div>
      </div>
    </section>
  </article>

  <CtaBand
    heading={d.cta?.heading || "Memory compounds.<br>Subscriptions don't."}
    sub={d.cta?.sub || 'Build memory your company owns.'}
    label="Book a live demo"
    caption="Source-<br>backed.<br>Privately<br>owned."
  />
</Base>
