---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import legacy from '../../data/legacy-blog-schema.json';

const posts = (await getCollection('blog')).sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date));
const [featured, ...rest] = posts;
const sections = [...new Set(posts.map((p) => p.data.section).filter(Boolean))];
---
<Base
  title="Compound Intelligence | The Deepvine.AI Blog"
  description="Private AI for law firms, RIAs, CPA firms, and knowledge-driven businesses: confidentiality rules, data ownership, institutional memory, and how private deployment changes the analysis."
  path="/blog/"
  schema={legacy}
>
  <PageHero eyebrow="The Deepvine.AI blog" title="Compound<br>Intelligence." lead="What changed, why it matters, and what a firm that owns its memory should do about it. Written for managing partners, principals, and owners who have to answer for where client data goes." size="md" />

  <section class="bloglist">
    <div class="container">
      {sections.length > 0 && (
        <ul class="tags" aria-label="Topics">
          {sections.map((s) => <li class="tag">{s}</li>)}
        </ul>
      )}
      {featured && <PostCard post={featured} featured />}
      <div class="bloglist__grid">
        {rest.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>

  <CtaBand heading="Memory compounds.<br>Subscriptions don't." sub="Build memory your company owns." label="Let's Talk" />
</Base>
