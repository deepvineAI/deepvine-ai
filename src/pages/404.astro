---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Page not found | Deepvine.AI" description="That page doesn't exist. Head back to Deepvine.AI." path="/404/">
  <PageHero
    eyebrow="404"
    title="That page isn't here."
    lead="The link may be old or mistyped. Everything on the site is one click away below."
    actions={[{ label: 'Back to the homepage', href: '/' }, { label: 'Read the blog', href: '/blog/', variant: 'light' }]}
    size="md"
  />
  <section class="qa">
    <div class="container qa__row">
      <div class="qa__side"><span class="qa__num">Solutions</span><h2>Looking for your industry?</h2></div>
      <div class="qa__body">
        <ul class="ucards">
          <li class="ucard"><a href="/private-ai-for-law-firms/"><strong>Law Firms</strong><span>Confidential, source-backed answers aligned with Rule 1.6(c).</span></a></li>
          <li class="ucard"><a href="/private-ai-for-rias/"><strong>RIAs</strong><span>Books-and-records ready, with client data kept inside the firm.</span></a></li>
          <li class="ucard"><a href="/private-ai-for-cpa-firms/"><strong>CPA Firms</strong><span>IRC §7216-aware deployment. Client tax data never leaves.</span></a></li>
          <li class="ucard"><a href="/private-ai-for-real-estate/"><strong>Real Estate Brokerages</strong><span>Deal history, files, and institutional knowledge in one private system.</span></a></li>
          <li class="ucard"><a href="/private-ai-for-hoa-management/"><strong>HOA / Community Managers</strong><span>Governing documents, answered with citations.</span></a></li>
          <li class="ucard"><a href="/about/"><strong>About Deepvine</strong><span>Who we are and why we build this way.</span></a></li>
        </ul>
      </div>
    </div>
  </section>
</Base>
