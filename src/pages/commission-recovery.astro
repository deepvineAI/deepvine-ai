---
// UNLISTED OFFER PAGE. Shared by direct link only.
// Not in the nav, footer, llms.txt or sitemap (see UNLISTED in astro.config.mjs); noindex via <Base noindex> and vercel.json.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { CALENDLY } from '../data/schema';

const title = 'Commission Recovery for Real Estate Teams | Deepvine.AI';
const description = 'We find the commission your team already paid for and did not collect, show you the leak before you pay, and do the work to recover it. Free 5-day audit for qualified teams.';
const cta = 'See if your team qualifies';

const sources = ['Zillow', 'Realtor.com', 'Google Ads', 'Facebook', 'Homes.com', 'your website'];

const leaks = [
  { t: 'Never called', d: 'They came in on a busy afternoon or a weekend. Nobody called back.' },
  { t: 'Dropped after two touches', d: 'Most people need more than two tries. The follow-up stopped first.' },
  { t: 'Old leads nobody works', d: 'Thousands of people who once raised their hand. Nobody has touched them since.' },
  { t: 'Nobody knows who dropped it', d: 'You can see calls and texts. You can\'t see which agent or lead source is losing you money.' },
];

const timeline = [
  { when: 'Day 7', t: 'A daily call list for every agent', d: 'Each morning, every agent gets the five leads most worth calling today.' },
  { when: 'Day 14', t: 'Old leads get worked', d: 'Your follow-up rules, run on the old leads nobody has touched. Replies go straight to an agent.' },
  { when: 'Day 30', t: 'Your Monday scorecard', d: 'One message every Monday: what was recovered, what stalled, and who stalled it. In dollars.' },
  { when: 'Every day', t: 'You see who dropped the ball', d: 'If an agent skips a lead, you hear about it the next morning, with what that lead is worth.' },
  { when: 'Every quarter', t: 'Quarterly check-up', d: 'We re-run the audit and show you what changed.' },
];

// Hero illustration: one dot per lead. Fixed pattern (no randomness) so every build and every visitor sees the same picture.
const COLS = 14, ROWS = 10;
let won = 0;
const dots = Array.from({ length: COLS * ROWS }, (_, i) => {
  const h = (i * 73 + ((i * i) % 17) * 29 + Math.floor(i / COLS) * 11) % 100;
  if (h >= 30) return { state: 'worked', delay: 0 };
  if (h >= 19) return { state: 'missed', delay: 0 };
  return { state: 'won', delay: 500 + won++ * 85 };
});

// ROI calculator (section 04). Server-renders the default state so the page reads correctly before the script runs.
const MONTHLY = 1500;
const COST = 12 * MONTHLY; // yearly run rate, the basis for the headline return and ROI
const SETUP = 10000;        // one-time fee, added only in the 'Year one with setup' line
const D = { closings: 10, gci: 13500, share: 50 };
const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const signed = (n: number) => (n < 0 ? '-' : '+') + usd(Math.abs(n));
const pct = (n: number) => (n < 0 ? '-' : '+') + Math.abs(Math.round(n)) + '%';
const calc = (c: number, g: number, sh: number) => {
  const kept = c * g * (sh / 100), net = kept - COST, roi = (net / COST) * 100, top = Math.max(kept, COST);
  const line = net >= 0
    ? `Every $1 you spend brings back ${'$' + (kept / COST).toFixed(2)}.`
    : `Not covered yet. You need ${Math.ceil(COST / (g * (sh / 100)))} extra closings to break even.`;
  const y1net = kept - COST - SETUP, y1roi = (y1net / (COST + SETUP)) * 100;
  return { kept, net, roi, y1net, y1roi, keptW: (kept / top) * 100, costW: (COST / top) * 100, line };
};
const d0 = calc(D.closings, D.gci, D.share);

const faq = [
  { q: 'Do we have to change our CRM?', a: 'No. Your CRM stays exactly as it is. Your agents keep working where they work today.' },
  { q: 'Do you write our follow-up campaigns?', a: 'No. We use your rules. If they are not written down, we write up what your best agents already do, and you approve it first.' },
  { q: 'What do our agents have to do differently?', a: 'Read one message a day and make the calls. No new login.' },
  { q: 'We do not use Zillow. Does this still work?', a: 'Yes. The audit reads every lead source in your CRM. Our case study team used Zillow, so your number may look different.' },
  { q: 'What if the audit does not find much?', a: 'Then we tell you not to hire us. Under $84,000 a year, you owe nothing.' },
  { q: 'Is our data safe?', a: 'Yes. It stays on a private system set up only for your team, under a signed agreement.' },
];
---
<Base title={title} description={description} path="/commission-recovery/" noindex minimal>
  <a slot="header-cta" class="btn btn--dark btn--sm" href={CALENDLY} target="_blank" rel="noopener">{cta} <span class="arrow">→</span></a>

  <PageHero
    eyebrow="Commission Recovery · For real estate team owners"
    split
    title="<span>You paid for every lead in your CRM.</span><span>We recover what your team didn't collect, every single day.</span>"
    lead="We find the commission that slipped through, show you the number for free, then do the work to get it back."
    chips={['Free 5-day audit', 'Done for you', 'See your number first']}
    actions={[{ label: cta, href: CALENDLY }]}
    note="Private offer, shared by invitation. For teams that pay for their leads."
  >
    <figure slot="aside" class="leadfield" aria-label="Illustration: a grid of dots, one for each lead a team paid for. Most were worked, some slipped through, and many of those are recovered.">
      <figcaption class="leadfield__title">Every lead you paid for</figcaption>
      <div class="leadfield__grid" aria-hidden="true">
        {dots.map((d) => <i class={`is-${d.state}`} style={d.state === 'won' ? `--d:${d.delay}ms` : undefined}></i>)}
      </div>
      <ul class="leadfield__key" aria-hidden="true">
        <li class="is-worked">Worked</li>
        <li class="is-missed">Slipped through</li>
        <li class="is-won">Recovered</li>
      </ul>
    </figure>
  </PageHero>

  <section class="cr-problem">
    <div class="container">
      <div class="cr-problem__head">
        <span class="eyebrow">The problem</span>
        <h2>Your team bought the leads. Nobody worked all of them.</h2>
        <p class="cr-problem__lead">Every month, some leads fall through. Here is where the commission goes.</p>
      </div>
      <ul class="cr-problem__grid">
        {leaks.map((l) => <li class="cr-leak"><i aria-hidden="true"></i><strong>{l.t}</strong><span>{l.d}</span></li>)}
      </ul>
      <p class="cr-problem__close">You already paid for every one of them.</p>
    </div>
  </section>

  <section class="cr-audit">
    <div class="container cr-audit__row">
      <div class="cr-audit__copy">
        <span class="eyebrow">How it works · Step 1</span>
        <h2>A free audit. Five business days.</h2>
        <p>Give us read-only access to your CRM. In five business days you get one number: the commission you're losing each year, and where it's going.</p>
        <p class="cr-audit__rule">If we find less than $84,000 a year, don't hire us.</p>
        <ul class="cr-audit__checks">
          <li>Free for qualified teams</li>
          <li>Nothing to install</li>
          <li>Nothing changes in your CRM</li>
        </ul>
        <a class="btn btn--dark" href={CALENDLY} target="_blank" rel="noopener">{cta} <span class="arrow">→</span></a>
        <p class="cr-audit__src">Works with whatever feeds your CRM: {sources.join(', ')}.</p>
      </div>
      <div class="sv-stage cr-audit__shot">
        <div class="sv-card" aria-hidden="true">
        <p class="sv-card__head"><span>Leak audit</span><em>Sample</em></p>
        <p class="sv-num">$142,000</p>
        <p class="sv-sub">leaking per year</p>
        <div class="sv-bars">
        <div><span>Zillow</span><i><b class="a-grow" style="--w:82%"></b></i></div>
        <div><span>Google Ads</span><i><b class="a-grow" style="--w:54%"></b></i></div>
        <div><span>Website</span><i><b class="a-grow" style="--w:31%"></b></i></div>
        </div>
        </div>
        <p class="cr-audit__cap">A sample of what you receive. Figures are made up.</p>
      </div>
    </div>
  </section>

  <section class="qa">
    <div class="container qa__row">
      <div class="qa__side"><span class="qa__num">How it works · Step 2</span><h2>We do the recovery. Your team makes the calls.</h2></div>
      <div class="qa__body">
        <p><strong>You already have follow-up rules. We make sure every lead actually gets them.</strong></p>
        <p>We use your team's rules and scripts, not ours. Your agents get one message a day.</p>
        <div class="tl" data-flow>
          <ol class="tl__steps">
            {timeline.map((s, i) => (
              <li class:list={['tl__item', { 'is-active': i === 0 }]}>
                <button type="button" class="tl__btn" aria-current={i === 0 ? 'step' : undefined}>
                  <span class="tl__when">{s.when}</span>
                  <strong>{s.t}</strong>
                </button>
                <p class="tl__desc">{s.d}</p>
                <div class="sv-stage">
                  {i === 0 && (
                    <div class="sv-card" aria-hidden="true">
                      <p class="sv-card__head"><span>Your five for today</span><em>7:30 AM</em></p>
                      <ul class="sv-list">
                        <li class="a-in" style="--i:0"><u></u>Seller lead, day 3, no call yet</li>
                        <li class="a-in" style="--i:1"><u></u>Buyer asked for a showing Friday</li>
                        <li class="a-in" style="--i:2"><u></u>Pre-approved, gone quiet 9 days</li>
                        <li class="a-in" style="--i:3"><u></u>Past client, home value request</li>
                        <li class="a-in" style="--i:4"><u></u>Open house sign-in, two visits</li>
                      </ul>
                    </div>
                  )}
                  {i === 1 && (
                    <div class="sv-card" aria-hidden="true">
                      <p class="sv-card__head"><span>Old leads</span><em>Sample</em></p>
                      <ul class="sv-rows">
                        <li>Lead from 2023<small>No reply</small></li>
                        <li class="is-hot a-in" style="--i:1">Lead from 2024<small>Replied</small></li>
                        <li>Lead from 2022<small>No reply</small></li>
                      </ul>
                      <p class="sv-bubble a-in" style="--i:3">Yes, still looking. Can someone call me?</p>
                      <p class="sv-tag a-in" style="--i:5">Handed to an agent</p>
                    </div>
                  )}
                  {i === 2 && (
                    <div class="sv-card" aria-hidden="true">
                      <p class="sv-card__head"><span>Monday scorecard</span><em>Sample</em></p>
                      <div class="sv-tiles">
                        <div><b>$18,400</b><span>Recovered</span></div>
                        <div class="is-warn"><b>$9,200</b><span>Stalled</span></div>
                      </div>
                      <p class="sv-sub sv-sub--gap">Stalled, by agent</p>
                      <div class="sv-bars sv-bars--warn">
                        <div><span>Agent A</span><i><b class="a-grow" style="--w:68%"></b></i></div>
                        <div><span>Agent B</span><i><b class="a-grow" style="--w:24%"></b></i></div>
                      </div>
                    </div>
                  )}
                  {i === 3 && (
                    <div class="sv-card" aria-hidden="true">
                      <p class="sv-card__head"><span>Missed yesterday</span><em>Sample</em></p>
                      <ul class="sv-alerts">
                        <li class="a-in" style="--i:0"><u>A</u><span>Seller lead<small>No call in 48 hours</small></span><b>$7,500</b></li>
                        <li class="a-in" style="--i:2"><u>B</u><span>Showing request<small>Not answered</small></span><b>$5,000</b></li>
                      </ul>
                    </div>
                  )}
                  {i === 4 && (
                    <div class="sv-card" aria-hidden="true">
                      <p class="sv-card__head"><span>Follow-up completed</span><em>Sample</em></p>
                      <div class="sv-cols">
                        <div><i><b class="a-rise" style="--h:38%"></b></i><span>Baseline</span></div>
                        <div><i><b class="a-rise" style="--h:58%"></b></i><span>Q1</span></div>
                        <div><i><b class="a-rise" style="--h:74%"></b></i><span>Q2</span></div>
                        <div><i><b class="a-rise" style="--h:86%"></b></i><span>Q3</span></div>
                      </div>
                    </div>
                  )}
                  <p class="sv-stage__desc">{s.d}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <p class="qa__fine tl__note">Sample screens. Figures are made up.</p>
      </div>
    </div>
  </section>

  <section class="qa qa--band">
    <div class="container qa__row">
      <div class="qa__side"><span class="qa__num">Proof</span><h2>What one audit found.</h2></div>
      <div class="qa__body">
        <div class="proof">
          <p class="proof__label">One real team · name withheld</p>
          <p class="proof__num">$119K to $198K a year</p>
          <p>That's what our audit found leaking at a team closing 400+ deals a year.</p>
          <p class="proof__fine">One team's result, not a promise. Your audit gives you your own number.</p>
        </div>
        <p>They already had a CRM and a paid lead program. The leak was still there.</p>
      </div>
    </div>
  </section>

  <section class="qa">
    <div class="container qa__row">
      <div class="qa__side"><span class="qa__num">The math</span><h2>About three extra closings covers the year.</h2></div>
      <div class="qa__body">
        <p>Move the sliders to match your team.</p>
        <div class="calc" data-calc data-cost={COST} data-setup={SETUP}>
          <div class="calc__inputs">
            <label class="calc__field">
              <span class="calc__label">Extra closings per year <output data-out="closings">{D.closings}</output></span>
              <input type="range" min="1" max="40" step="1" value={D.closings} data-in="closings" aria-label="Extra closings per year">
              <span class="calc__scale"><span>1</span><span>40</span></span>
            </label>
            <label class="calc__field">
              <span class="calc__label">Average commission per closing <output data-out="gci">{usd(D.gci)}</output></span>
              <input type="range" min="5000" max="30000" step="500" value={D.gci} data-in="gci" aria-label="Average commission per closing">
              <span class="calc__scale"><span>$5,000</span><span>$30,000</span></span>
            </label>
            <label class="calc__field">
              <span class="calc__label">Your share after agent splits <output data-out="share">{D.share}%</output></span>
              <input type="range" min="20" max="100" step="5" value={D.share} data-in="share" aria-label="Your share after agent splits">
              <span class="calc__scale"><span>20%</span><span>100%</span></span>
            </label>
          </div>
          <div class="calc__results" aria-live="polite">
            <div class="calc__cost">
              <span class="calc__cap">Your cost</span>
              <strong>{usd(COST)} <small>a year</small></strong>
              <span class="calc__sub">{usd(MONTHLY)} a month × 12 months</span>
            </div>
            <div class="calc__big">
              <div><span class="calc__cap">Yearly return</span><strong data-out="net">{signed(d0.net)}</strong></div>
              <div><span class="calc__cap">ROI</span><strong data-out="roi">{pct(d0.roi)}</strong></div>
            </div>
            <div class="calc__y1">
              <span>Year one, with {usd(SETUP)} setup</span>
              <b><span data-out="y1net">{signed(d0.y1net)}</span> · <span data-out="y1roi">{pct(d0.y1roi)}</span> ROI</b>
            </div>
            <div class="calc__bars">
              <div class="calc__bar"><span>What you keep</span><b data-out="kept">{usd(d0.kept)}</b><i><em data-bar="kept" style={`width:${d0.keptW}%`}></em></i></div>
              <div class="calc__bar calc__bar--cost"><span>Your cost</span><b>{usd(COST)}</b><i><em data-bar="cost" style={`width:${d0.costW}%`}></em></i></div>
            </div>
            <p class="calc__line" data-out="line">{d0.line}</p>
          </div>
        </div>
        <p class="qa__fine">Yearly numbers use the $1,500 monthly fee. Year one adds the one-time $10,000 setup. This is an estimate, not a promise.</p>
      </div>
    </div>
  </section>

  <section class="qa qa--band">
    <div class="container qa__row">
      <div class="qa__side"><span class="qa__num">Pricing</span><h2>You see your number before you pay anything.</h2></div>
      <div class="qa__body">
        <div class="offer offer--wide">
          <ul class="offer__lines">
            <li><span>Leak Audit<small>5 business days. Read-only.</small></span><strong>Free</strong></li>
            <li><span>Setup<small>Only if your audit finds $84,000 or more</small></span><strong>$10,000</strong></li>
            <li><span>Monthly recovery<small>12 months. We run it. Your agents make the calls.</small></span><strong>$1,500 / month</strong></li>
          </ul>
          <h3>Two guarantees</h3>
          <ul class="offer__points">
            <li><strong>Before you pay:</strong> if the audit finds less than $84,000 a year, we tell you not to hire us.</li>
            <li><strong>Day 90:</strong> if your agents aren't following up more than before, you can leave.</li>
          </ul>
          <a class="btn btn--dark" href={CALENDLY} target="_blank" rel="noopener">{cta} <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="qa">
    <div class="container qa__row">
      <div class="qa__side"><span class="qa__num">Fit</span><h2>Built for a specific kind of team.</h2></div>
      <div class="qa__body">
        <div class="fit">
          <div class="fit__col">
            <h3>This is for you if</h3>
            <ul>
              <li>Your leads live in one CRM</li>
              <li>You pay for leads</li>
              <li>You close 170+ deals a year, or spend $10K+ a month on leads</li>
              <li>You want it done for you</li>
            </ul>
          </div>
          <div class="fit__col fit__col--no">
            <h3>This is not for you if</h3>
            <ul>
              <li>You're a solo agent working referrals</li>
              <li>You already see every lead yourself</li>
              <li>You want a new CRM or a content tool</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faq} heading="Questions, answered." />


  <CtaBand heading="Bring us<br>your CRM." sub="In five business days, we'll show you what it's leaking. In dollars." label={cta} caption="Your<br>number,<br>before<br>you pay." />
</Base>

<script>
  // Step-by-step timeline: selecting a step shows its sample screen. Without this script every step and screen is simply shown.
  document.querySelectorAll<HTMLElement>('[data-flow]').forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLElement>('.tl__item'));
    const pick = (li: HTMLElement) => items.forEach((x) => {
      const on = x === li;
      x.classList.toggle('is-active', on);
      const b = x.querySelector('.tl__btn')!;
      on ? b.setAttribute('aria-current', 'step') : b.removeAttribute('aria-current');
    });
    const hover = window.matchMedia('(hover: hover) and (min-width: 901px)');
    items.forEach((li) => {
      const b = li.querySelector<HTMLElement>('.tl__btn')!;
      b.addEventListener('click', () => {
        pick(li);
        // on phones the open step changes the layout above; keep the tapped step on screen
        if (!hover.matches) setTimeout(() => { const r = b.getBoundingClientRect(); if (r.top < 90 || r.top > innerHeight - 140) window.scrollTo({ top: Math.max(0, scrollY + r.top - 100), behavior: 'instant' }); }, 60);
      });
      b.addEventListener('focus', () => pick(li));
      b.addEventListener('mouseenter', () => { if (hover.matches) pick(li); });
    });
    root.classList.add('is-js');
  });

  // ROI calculator: same arithmetic as the server-rendered default in the frontmatter.
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach((root) => {
    const COST = Number(root.dataset.cost), SETUP = Number(root.dataset.setup);
    const el = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const inp = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
    const bar = (k: string) => root.querySelector<HTMLElement>(`[data-bar="${k}"]`)!;
    const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    const sign = (n: number) => (n < 0 ? '-' : '+');
    const fill = (i: HTMLInputElement) => i.style.setProperty('--fill', ((Number(i.value) - Number(i.min)) / (Number(i.max) - Number(i.min))) * 100 + '%');
    const update = () => {
      const c = Number(inp('closings').value), g = Number(inp('gci').value), sh = Number(inp('share').value);
      const kept = c * g * (sh / 100), net = kept - COST, roi = (net / COST) * 100, top = Math.max(kept, COST);
      el('closings').textContent = String(c);
      el('gci').textContent = usd(g);
      el('share').textContent = sh + '%';
      el('kept').textContent = usd(kept);
      el('net').textContent = sign(net) + usd(Math.abs(net));
      el('roi').textContent = sign(roi) + Math.abs(Math.round(roi)) + '%';
      const y1net = kept - COST - SETUP, y1roi = (y1net / (COST + SETUP)) * 100;
      el('y1net').textContent = sign(y1net) + usd(Math.abs(y1net));
      el('y1roi').textContent = sign(y1roi) + Math.abs(Math.round(y1roi)) + '%';
      el('line').textContent = net >= 0
        ? `Every $1 you spend brings back $${(kept / COST).toFixed(2)}.`
        : `Not covered yet. You need ${Math.ceil(COST / (g * (sh / 100)))} extra closings to break even.`;
      root.classList.toggle('calc--neg', net < 0);
      bar('kept').style.width = (kept / top) * 100 + '%';
      bar('cost').style.width = (COST / top) * 100 + '%';
      ['closings', 'gci', 'share'].forEach((k) => fill(inp(k)));
    };
    root.addEventListener('input', update);
    update();
  });
</script>
