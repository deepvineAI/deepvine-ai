---
// UNLISTED OFFER PAGE. Shared by direct link only.
// Not in the nav, footer, llms.txt or sitemap (see UNLISTED in astro.config.mjs); noindex via <Base noindex> and vercel.json.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { CALENDLY } from '../data/schema';

const title = 'Commission Recovery for Real Estate Teams | Deepvine.AI';
const description = 'We find the commission your team already paid for and did not collect, show you the leak before you pay, and do the work to recover it. Free 5-day audit for qualified teams.';
const cta = 'See if your team qualifies';

const sources = ['Zillow', 'Realtor.com', 'Google Ads', 'Facebook', 'Homes.com', 'your website'];

const leaks = [
  { t: 'Never called', d: 'Leads that came in on a busy afternoon or a weekend. Nobody circled back.' },
  { t: 'Dropped after two touches', d: 'Most buyers and sellers take far longer than that to answer. The follow-up stopped first.' },
  { t: 'Old leads nobody works', d: 'Thousands of people who once raised their hand, untouched since the month they came in.' },
  { t: 'No view of the cost', d: 'You can see activity. You cannot see what each agent and each lead source costs you per closing.' },
];

const timeline = [
  { when: 'Day 7', t: 'Daily agent briefs', d: 'Every morning each agent gets their five most valuable moves by text, email or Slack, written from your own follow-up standards.' },
  { when: 'Day 14', t: 'Dead database revival', d: 'Your follow-up rules, applied to the old and unworked leads nobody has touched. Outreach goes through your own accounts and action plans, and each reply is handed to an agent.' },
  { when: 'Day 30', t: 'Owner scorecard', d: 'One message every Monday: what was recovered, what stalled, and who stalled it, in dollars.' },
  { when: 'Every day', t: 'Escalation', d: 'Moves an agent skipped yesterday reach you this morning, with the value of the lead attached.' },
  { when: 'Every quarter', t: 'Re-audit', d: 'We measure against the baseline from your audit, so progress is a number and not an opinion.' },
];

// Hero illustration: one dot per lead. Fixed pattern (no randomness) so every build and every visitor sees the same picture.
const COLS = 14, ROWS = 10;
let won = 0;
const dots = Array.from({ length: COLS * ROWS }, (_, i) => {
  const h = (i * 73 + ((i * i) % 17) * 29 + Math.floor(i / COLS) * 11) % 100;
  if (h >= 30) return { state: 'worked', delay: 0 };
  if (h >= 19) return { state: 'missed', delay: 0 };
  return { state: 'won', delay: 500 + won++ * 85 };
});

// ROI calculator (section 04). Server-renders the default state so the page reads correctly before the script runs.
const COST = 10000 + 12 * 1500;
const D = { closings: 6, gci: 13500, share: 50 };
const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const signed = (n: number) => (n < 0 ? '-' : '+') + usd(Math.abs(n));
const pct = (n: number) => (n < 0 ? '-' : '+') + Math.abs(Math.round(n)) + '%';
const calc = (c: number, g: number, sh: number) => {
  const kept = c * g * (sh / 100), net = kept - COST, roi = (net / COST) * 100, top = Math.max(kept, COST);
  const line = net >= 0
    ? `Every dollar spent returns ${'$' + (kept / COST).toFixed(2)} in commission your company keeps.`
    : `Not yet covered. You need ${Math.ceil(COST / (g * (sh / 100)))} extra closings at these numbers to break even.`;
  return { kept, net, roi, keptW: (kept / top) * 100, costW: (COST / top) * 100, line };
};
const d0 = calc(D.closings, D.gci, D.share);

const faq = [
  { q: 'Do we have to change our CRM?', a: 'No. Your CRM stays exactly as it is. We connect to it, read from it, and write tasks and notes back into it. Nothing is replaced and your agents keep working where they work today.' },
  { q: 'We already have dashboards and reporting. How is this different?', a: 'Reporting shows you the problem and leaves the work to your team. We do the work: we find the specific leads, put them in front of the right agent every morning, chase what gets skipped, and apply your follow-up rules to the old database too. The scorecard is there to prove it, not to be the product.' },
  { q: 'We do not use Zillow. Does this still work?', a: 'Yes. The audit reads whatever sources feed your CRM, including Realtor.com, Google Ads, Facebook and your own website. The dollar figure in our case study came from a Zillow team, and we will tell you plainly how your mix compares once we have your numbers.' },
  { q: 'Do you write our follow-up campaigns?', a: 'No. Every team has its own rules, and yours are the ones we use. We build your standards into the system and make sure they are applied to every lead. If they are not written down yet, we document what your best agents already do, and you approve it before anything runs.' },
  { q: 'What do our agents have to do differently?', a: 'Read one message a day and make the calls on it. There is no new login and nothing to install. Your part as the owner is a single 60-minute kickoff.' },
  { q: 'Where does our data go?', a: 'It runs on a private Deepvine instance dedicated to your team, under a signed agreement. It is never used to train shared models, and we sell neither leads nor a CRM, so nobody on our side benefits from what your numbers say.' },
  { q: 'What if the audit does not find much?', a: 'Then we tell you not to hire us. If the audit finds less than $84,000 a year in leaking commission, you owe nothing and the engagement does not start.' },
  { q: 'What happens after 12 months?', a: 'You can continue month to month, add the full team knowledge layer, or stop. Your data and your baseline are yours either way.' },
];
---
<Base title={title} description={description} path="/commission-recovery/" noindex minimal>
  <a slot="header-cta" class="btn btn--dark btn--sm" href={CALENDLY} target="_blank" rel="noopener">{cta} <span class="arrow">→</span></a>

  <PageHero
    eyebrow="Commission Recovery · For real estate team owners"
    split
    title="<span>You paid for every lead in your CRM.</span><span>We recover what your team didn't collect, every single day.</span>"
    lead="You already have the CRM and the dashboards. We find the commission that slipped through, show you the leak before you pay us anything, and then do the work to recover it."
    chips={['Free 5-day audit', 'Done for you', 'Nothing to install', 'See your number first']}
    actions={[{ label: cta, href: CALENDLY }]}
    note="Private offer, shared by invitation. For teams that pay for their leads."
  >
    <figure slot="aside" class="leadfield" aria-label="Illustration: a grid of dots, one for each lead a team paid for. Most were worked, some slipped through, and many of those are recovered.">
      <figcaption class="leadfield__title">Every lead you paid for</figcaption>
      <div class="leadfield__grid" aria-hidden="true">
        {dots.map((d) => <i class={`is-${d.state}`} style={d.state === 'won' ? `--d:${d.delay}ms` : undefined}></i>)}
      </div>
      <ul class="leadfield__key" aria-hidden="true">
        <li class="is-worked">Worked</li>
        <li class="is-missed">Slipped through</li>
        <li class="is-won">Recovered</li>
      </ul>
    </figure>
  </PageHero>

  <section class="cr-problem">
    <div class="container">
      <div class="cr-problem__head">
        <span class="eyebrow">The problem</span>
        <h2>Your team bought the leads. Nobody worked all of them.</h2>
        <p class="cr-problem__lead">Hundreds of new names arrive every month, and each agent decides alone who gets the next call. Some leads always fall through. These are the four places the commission goes.</p>
      </div>
      <ul class="cr-problem__grid">
        {leaks.map((l) => <li class="cr-leak"><i aria-hidden="true"></i><strong>{l.t}</strong><span>{l.d}</span></li>)}
      </ul>
      <p class="cr-problem__close">You already paid for every one of them.</p>
    </div>
  </section>

  <section class="cr-audit">
    <div class="container cr-audit__row">
      <div class="cr-audit__copy">
        <span class="eyebrow">How it works · Step 1</span>
        <h2>A free audit. Five business days.</h2>
        <p>Give us read-only access to your CRM. We join it with your lead spend and closed deals, and hand you one number: the commission leaking each year, by agent and by source.</p>
        <p class="cr-audit__rule">If we find less than $84,000 a year, don't hire us.</p>
        <ul class="cr-audit__checks">
          <li>Free for qualified teams</li>
          <li>Nothing to install</li>
          <li>Nothing changes in your CRM</li>
        </ul>
        <a class="btn btn--dark" href={CALENDLY} target="_blank" rel="noopener">{cta} <span class="arrow">→</span></a>
        <p class="cr-audit__src">Works with whatever feeds your CRM: {sources.join(', ')}.</p>
      </div>
      <div class="sv-stage cr-audit__shot">
        <div class="sv-card" aria-hidden="true">
        <p class="sv-card__head"><span>Leak audit</span><em>Sample</em></p>
        <p class="sv-num">$142,000</p>
        <p class="sv-sub">leaking per year</p>
        <div class="sv-bars">
        <div><span>Zillow</span><i><b class="a-grow" style="--w:82%"></b></i></div>
        <div><span>Google Ads</span><i><b class="a-grow" style="--w:54%"></b></i></div>
        <div><span>Website</span><i><b class="a-grow" style="--w:31%"></b></i></div>
        </div>
        </div>
        <p class="cr-audit__cap">A sample of what you receive. Figures are made up.</p>
      </div>
    </div>
  </section>

  <section class="qa">
    <div class="container qa__row">
      <div class="qa__side"><span class="qa__num">How it works · Step 2</span><h2>We do the recovery. Your team makes the calls.</h2></div>
      <div class="qa__body">
        <p><strong>If the audit clears the bar and you hire us, this is what happens. You already have follow-up rules. We make sure every lead in your CRM actually gets them.</strong></p>
        <p>We take your team's own standards, steps and scripts, build them into the system, and apply them to every lead, every day. We don't bring our own campaigns. We enforce yours. Your agents answer one message a day.</p>
        <div class="tl" data-flow>
          <ol class="tl__steps">
            {timeline.map((s, i) => (
              <li class:list={['tl__item', { 'is-active': i === 0 }]}>
                <button type="button" class="tl__btn" aria-current={i === 0 ? 'step' : undefined}>
                  <span class="tl__when">{s.when}</span>
                  <strong>{s.t}</strong>
                </button>
                <p class="tl__desc">{s.d}</p>
                <div class="sv-stage">
                  {i === 0 && (
                    <div class="sv-card" aria-hidden="true">
                      <p class="sv-card__head"><span>Your five for today</span><em>7:30 AM</em></p>
                      <ul class="sv-list">
                        <li class="a-in" style="--i:0"><u></u>Seller lead, day 3, no call yet</li>
                        <li class="a-in" style="--i:1"><u></u>Buyer asked for a showing Friday</li>
                        <li class="a-in" style="--i:2"><u></u>Pre-approved, gone quiet 9 days</li>
                        <li class="a-in" style="--i:3"><u></u>Past client, home value request</li>
                        <li class="a-in" style="--i:4"><u></u>Open house sign-in, two visits</li>
                      </ul>
                    </div>
                  )}
                  {i === 1 && (
                    <div class="sv-card" aria-hidden="true">
                      <p class="sv-card__head"><span>Old leads</span><em>Sample</em></p>
                      <ul class="sv-rows">
                        <li>Lead from 2023<small>No reply</small></li>
                        <li class="is-hot a-in" style="--i:1">Lead from 2024<small>Replied</small></li>
                        <li>Lead from 2022<small>No reply</small></li>
                      </ul>
                      <p class="sv-bubble a-in" style="--i:3">Yes, still looking. Can someone call me?</p>
                      <p class="sv-tag a-in" style="--i:5">Handed to an agent</p>
                    </div>
                  )}
                  {i === 2 && (
                    <div class="sv-card" aria-hidden="true">
                      <p class="sv-card__head"><span>Monday scorecard</span><em>Sample</em></p>
                      <div class="sv-tiles">
                        <div><b>$18,400</b><span>Recovered</span></div>
                        <div class="is-warn"><b>$9,200</b><span>Stalled</span></div>
                      </div>
                      <p class="sv-sub sv-sub--gap">Stalled, by agent</p>
                      <div class="sv-bars sv-bars--warn">
                        <div><span>Agent A</span><i><b class="a-grow" style="--w:68%"></b></i></div>
                        <div><span>Agent B</span><i><b class="a-grow" style="--w:24%"></b></i></div>
                      </div>
                    </div>
                  )}
                  {i === 3 && (
                    <div class="sv-card" aria-hidden="true">
                      <p class="sv-card__head"><span>Missed yesterday</span><em>Sample</em></p>
                      <ul class="sv-alerts">
                        <li class="a-in" style="--i:0"><u>A</u><span>Seller lead<small>No call in 48 hours</small></span><b>$7,500</b></li>
                        <li class="a-in" style="--i:2"><u>B</u><span>Showing request<small>Not answered</small></span><b>$5,000</b></li>
                      </ul>
                    </div>
                  )}
                  {i === 4 && (
                    <div class="sv-card" aria-hidden="true">
                      <p class="sv-card__head"><span>Follow-up completed</span><em>Sample</em></p>
                      <div class="sv-cols">
                        <div><i><b class="a-rise" style="--h:38%"></b></i><span>Baseline</span></div>
                        <div><i><b class="a-rise" style="--h:58%"></b></i><span>Q1</span></div>
                        <div><i><b class="a-rise" style="--h:74%"></b></i><span>Q2</span></div>
                        <div><i><b class="a-rise" style="--h:86%"></b></i><span>Q3</span></div>
                      </div>
                    </div>
                  )}
                  <p class="sv-stage__desc">{s.d}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <p class="qa__fine tl__note">The panels show sample screens with made-up figures.</p>
      </div>
    </div>
  </section>

  <section class="qa qa--band">
    <div class="container qa__row">
      <div class="qa__side"><span class="qa__num">Proof</span><h2>What one audit found.</h2></div>
      <div class="qa__body">
        <div class="proof">
          <p class="proof__label">Client result · team name withheld</p>
          <p class="proof__num">$119K to $198K a year</p>
          <p>In commission leaking from the follow-up funnel of a team closing more than 400 transactions a year. We found it by joining their CRM data with their lead source metrics across a 90-day cohort.</p>
          <p class="proof__fine">This is the amount identified by the audit at one team, not a promise of what yours will show. Your audit produces your own number.</p>
        </div>
        <p>That team was already running a CRM and a paid lead program at scale. The leak was still there, because finding it and working it every day is a job nobody on a busy team owns.</p>
      </div>
    </div>
  </section>

  <section class="qa">
    <div class="container qa__row">
      <div class="qa__side"><span class="qa__num">The math</span><h2>About five extra closings covers the first year.</h2></div>
      <div class="qa__body">
        <p>At a $13,500 average commission, five extra closings a year covers the cost. The example starts at six. Move the sliders to match your team and see what year one returns.</p>
        <div class="calc" data-calc data-cost={COST}>
          <div class="calc__inputs">
            <label class="calc__field">
              <span class="calc__label">Extra closings per year <output data-out="closings">{D.closings}</output></span>
              <input type="range" min="1" max="40" step="1" value={D.closings} data-in="closings" aria-label="Extra closings per year">
              <span class="calc__scale"><span>1</span><span>40</span></span>
            </label>
            <label class="calc__field">
              <span class="calc__label">Average commission per closing <output data-out="gci">{usd(D.gci)}</output></span>
              <input type="range" min="5000" max="30000" step="500" value={D.gci} data-in="gci" aria-label="Average commission per closing">
              <span class="calc__scale"><span>$5,000</span><span>$30,000</span></span>
            </label>
            <label class="calc__field">
              <span class="calc__label">Share the company keeps after agent splits <output data-out="share">{D.share}%</output></span>
              <input type="range" min="20" max="100" step="5" value={D.share} data-in="share" aria-label="Share of commission the company keeps">
              <span class="calc__scale"><span>20%</span><span>100%</span></span>
            </label>
          </div>
          <div class="calc__results" aria-live="polite">
            <div class="calc__big">
              <div><span class="calc__cap">Year one return</span><strong data-out="net">{signed(d0.net)}</strong></div>
              <div><span class="calc__cap">Year one ROI</span><strong data-out="roi">{pct(d0.roi)}</strong></div>
            </div>
            <div class="calc__bars">
              <div class="calc__bar"><span>Commission your company keeps</span><b data-out="kept">{usd(d0.kept)}</b><i><em data-bar="kept" style={`width:${d0.keptW}%`}></em></i></div>
              <div class="calc__bar calc__bar--cost"><span>Year one cost</span><b>{usd(COST)}</b><i><em data-bar="cost" style={`width:${d0.costW}%`}></em></i></div>
            </div>
            <p class="calc__line" data-out="line">{d0.line}</p>
          </div>
        </div>
        <p class="qa__fine">How it is calculated: extra closings × average commission × company share, minus the $28,000 year one cost ($10,000 install plus 12 months at $1,500). ROI is that return divided by the cost.</p>
        <p class="qa__fine">An estimate from the numbers you enter, not a promise of results. Your audit replaces these with your own figures.</p>
      </div>
    </div>
  </section>

  <section class="qa qa--band">
    <div class="container qa__row">
      <div class="qa__side"><span class="qa__num">Pricing</span><h2>You see your number before you pay anything.</h2></div>
      <div class="qa__body">
        <div class="offer offer--wide">
          <ul class="offer__lines">
            <li><span>Leak Audit<small>5 business days, read-only, for qualified teams</small></span><strong>Free</strong></li>
            <li><span>Install<small>Due only after your audit clears the $84K floor</small></span><strong>$10,000</strong></li>
            <li><span>Managed Recovery<small>12 months. Briefs, escalation, database revival, scorecard, quarterly re-audit</small></span><strong>$1,500 / month</strong></li>
          </ul>
          <h3>Two guarantees</h3>
          <ul class="offer__points">
            <li><strong>Before you pay:</strong> if the audit finds less than $84,000 a year in leaking commission, we tell you not to hire us.</li>
            <li><strong>Day 90:</strong> if follow-up completion has not improved against your baseline, you can leave.</li>
          </ul>
          <a class="btn btn--dark" href={CALENDLY} target="_blank" rel="noopener">{cta} <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="qa">
    <div class="container qa__row">
      <div class="qa__side"><span class="qa__num">Fit</span><h2>Built for a specific kind of team.</h2></div>
      <div class="qa__body">
        <div class="fit">
          <div class="fit__col">
            <h3>This is for you if</h3>
            <ul>
              <li>Your team keeps its leads in one CRM</li>
              <li>You pay for leads, up front or at closing</li>
              <li>You close about 170 or more transactions a year, or spend about $10,000 or more a month on leads</li>
              <li>You want the work done, not another login</li>
            </ul>
          </div>
          <div class="fit__col fit__col--no">
            <h3>This is not for you if</h3>
            <ul>
              <li>You are a solo agent working mostly referrals</li>
              <li>Your team is small enough that you already see every lead yourself</li>
              <li>You are looking for a new CRM or a marketing content tool</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faq} heading="Questions, answered." />


  <CtaBand heading="Bring us<br>your CRM." sub="In five business days we'll show you what it's leaking, by agent and by source, in dollars." label={cta} caption="Your<br>number,<br>before<br>you pay." />
</Base>

<script>
  // Step-by-step timeline: selecting a step shows its sample screen. Without this script every step and screen is simply shown.
  document.querySelectorAll<HTMLElement>('[data-flow]').forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLElement>('.tl__item'));
    const pick = (li: HTMLElement) => items.forEach((x) => {
      const on = x === li;
      x.classList.toggle('is-active', on);
      const b = x.querySelector('.tl__btn')!;
      on ? b.setAttribute('aria-current', 'step') : b.removeAttribute('aria-current');
    });
    const hover = window.matchMedia('(hover: hover) and (min-width: 901px)');
    items.forEach((li) => {
      const b = li.querySelector<HTMLElement>('.tl__btn')!;
      b.addEventListener('click', () => {
        pick(li);
        // on phones the open step changes the layout above; keep the tapped step on screen
        if (!hover.matches) setTimeout(() => { const r = b.getBoundingClientRect(); if (r.top < 90 || r.top > innerHeight - 140) window.scrollTo({ top: Math.max(0, scrollY + r.top - 100), behavior: 'instant' }); }, 60);
      });
      b.addEventListener('focus', () => pick(li));
      b.addEventListener('mouseenter', () => { if (hover.matches) pick(li); });
    });
    root.classList.add('is-js');
  });

  // ROI calculator: same arithmetic as the server-rendered default in the frontmatter.
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach((root) => {
    const COST = Number(root.dataset.cost);
    const el = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const inp = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
    const bar = (k: string) => root.querySelector<HTMLElement>(`[data-bar="${k}"]`)!;
    const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    const sign = (n: number) => (n < 0 ? '-' : '+');
    const fill = (i: HTMLInputElement) => i.style.setProperty('--fill', ((Number(i.value) - Number(i.min)) / (Number(i.max) - Number(i.min))) * 100 + '%');
    const update = () => {
      const c = Number(inp('closings').value), g = Number(inp('gci').value), sh = Number(inp('share').value);
      const kept = c * g * (sh / 100), net = kept - COST, roi = (net / COST) * 100, top = Math.max(kept, COST);
      el('closings').textContent = String(c);
      el('gci').textContent = usd(g);
      el('share').textContent = sh + '%';
      el('kept').textContent = usd(kept);
      el('net').textContent = sign(net) + usd(Math.abs(net));
      el('roi').textContent = sign(roi) + Math.abs(Math.round(roi)) + '%';
      el('line').textContent = net >= 0
        ? `Every dollar spent returns $${(kept / COST).toFixed(2)} in commission your company keeps.`
        : `Not yet covered. You need ${Math.ceil(COST / (g * (sh / 100)))} extra closings at these numbers to break even.`;
      root.classList.toggle('calc--neg', net < 0);
      bar('kept').style.width = (kept / top) * 100 + '%';
      bar('cost').style.width = (COST / top) * 100 + '%';
      ['closings', 'gci', 'share'].forEach((k) => fill(inp(k)));
    };
    root.addEventListener('input', update);
    update();
  });
</script>
