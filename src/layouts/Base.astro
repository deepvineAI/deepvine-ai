---
import '../styles/site.css';
import '../styles/pages.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, DEFAULT_OG, graph as buildGraph } from '../data/schema';

interface Props {
  title: string;
  description: string;
  path: string;                       // site-relative, with trailing slash: "/about/"
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schema?: (string | object)[];       // extra JSON-LD blocks (objects or pre-serialised strings)
  graph?: (object | null | undefined | false)[]; // nodes for this page's single @graph
  preloadHero?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  bodyClass?: string;
}
const {
  title, description, path,
  ogTitle = title, ogDescription = description,
  ogImage = DEFAULT_OG, ogType = 'website',
  schema = [], graph = [], preloadHero = false, publishedTime, modifiedTime, bodyClass,
} = Astro.props;
const canonical = SITE + path;
const ld = [
  ...(graph.some(Boolean) ? [JSON.stringify(buildGraph(graph))] : []),
  ...schema.map((s) => (typeof s === 'string' ? s : JSON.stringify(s))),
];
---
<!DOCTYPE html>
<html lang="en">
<head>
<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LQMY9C69YW"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-LQMY9C69YW');
</script>

<meta charset="UTF-8">
<meta name="facebook-domain-verification" content="hjii888kt8gentccve9jljlovyfjz6" />
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
<meta name="theme-color" content="#fbfbfa">

<!-- Open Graph -->
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="Deepvine.AI">
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogTitle}>
<meta property="og:locale" content="en_US">
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={ogDescription}>
<meta name="twitter:image" content={ogImage}>

<!-- Favicons -->
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="shortcut icon" href="/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<meta name="apple-mobile-web-app-title" content="Deepvine.AI">
<link rel="manifest" href="/site.webmanifest">

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
{preloadHero && <link rel="preload" as="image" href="/assets/img/hero-desk.webp" />}

{ld.map((json) => <script type="application/ld+json" is:inline set:html={json} />)}
</head>
<body class={bodyClass}>
<Nav />
<main>
  <slot />
</main>
<Footer />
<script src="../scripts/site.js"></script>
</body>
</html>
