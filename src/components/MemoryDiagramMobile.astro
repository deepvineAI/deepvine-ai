---
/* Phone edition of the Memory Layer diagram: same cards, device and connectors, stacked vertically. */
const S = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const I = {
  doc: S('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h6"/>'),
  chat: S('<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8M8 12h5"/>'),
  db: S('<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>'),
  gear: S('<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>'),
  spark: S('<path d="M12 3l2.3 6.2L20.5 11.5l-6.2 2.3L12 20l-2.3-6.2L3.5 11.5l6.2-2.3z"/>'),
  grid: S('<rect x="4" y="4" width="6.5" height="6.5" rx="1.6"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.6"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.6"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.6"/>'),
  cube: S('<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z"/><path d="M12 12 20 7.5M12 12v9M12 12 4 7.5"/>'),
  slack: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#E01E5A" d="M5.5 15.2a2.1 2.1 0 1 1-2.1-2.1h2.1zm1.1 0a2.1 2.1 0 1 1 4.2 0v5.3a2.1 2.1 0 1 1-4.2 0z"/><path fill="#36C5F0" d="M8.8 5.5a2.1 2.1 0 1 1 2.1-2.1v2.1zm0 1.1a2.1 2.1 0 1 1 0 4.2H3.5a2.1 2.1 0 1 1 0-4.2z"/><path fill="#2EB67D" d="M18.5 8.8a2.1 2.1 0 1 1 2.1 2.1h-2.1zm-1.1 0a2.1 2.1 0 1 1-4.2 0V3.5a2.1 2.1 0 1 1 4.2 0z"/><path fill="#ECB22E" d="M15.2 18.5a2.1 2.1 0 1 1-2.1 2.1v-2.1zm0-1.1a2.1 2.1 0 1 1 0-4.2h5.3a2.1 2.1 0 1 1 0 4.2z"/></svg>',
};
const inputs = [
  { icon: I.doc, label: 'Documents' }, { icon: I.chat, label: 'Conversations' },
  { icon: I.db, label: 'Deal Data' }, { icon: I.gear, label: 'Internal Systems' },
];
const outputs = [
  { icon: I.spark, label: 'AI Model' }, { icon: I.grid, label: 'Deepvine.AI Agents' },
  { icon: I.slack, label: 'Slack' }, { icon: I.cube, label: 'Your Tools' },
];
---
<div class="mdm" aria-hidden="true">
  <ul class="mdm__grid">
    {inputs.map((c) => <li class="mdm__card"><span class="mdm__ico" set:html={c.icon} />{c.label}</li>)}
  </ul>
  <svg class="mdm__link" viewBox="0 0 320 64" preserveAspectRatio="none">
    <path d="M80 0 V22 Q80 32 90 32 H150 Q160 32 160 42 V64" vector-effect="non-scaling-stroke"/>
    <path d="M240 0 V22 Q240 32 230 32 H170 Q160 32 160 42 V64" vector-effect="non-scaling-stroke"/>
    <circle cx="80" cy="2" r="3.5"/><circle cx="240" cy="2" r="3.5"/><circle cx="160" cy="62" r="3.5"/>
  </svg>
  <div class="mdm__hub"><img src="/assets/img/device-cutout.webp" width="484" height="354" alt="" loading="lazy"></div>
  <svg class="mdm__link" viewBox="0 0 320 64" preserveAspectRatio="none">
    <path d="M160 0 V22 Q160 32 150 32 H90 Q80 32 80 42 V64" vector-effect="non-scaling-stroke"/>
    <path d="M160 0 V22 Q160 32 170 32 H230 Q240 32 240 42 V64" vector-effect="non-scaling-stroke"/>
    <circle cx="160" cy="2" r="3.5"/><circle cx="80" cy="62" r="3.5"/><circle cx="240" cy="62" r="3.5"/>
  </svg>
  <ul class="mdm__grid">
    {outputs.map((c) => <li class="mdm__card"><span class="mdm__ico" set:html={c.icon} />{c.label}</li>)}
  </ul>
</div>
