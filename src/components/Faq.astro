---
interface Item { q: string; a: string }
interface Props { items: Item[]; eyebrow?: string; heading?: string; lead?: string }
const { items, eyebrow = 'FAQ', heading = 'Frequently asked questions', lead } = Astro.props;
---
{items.length > 0 && (
  <section class="faqs" id="faq">
    <div class="container faqs__grid">
      <div class="faqs__head">
        <p class="eyebrow">{eyebrow}</p>
        <h2>{heading}</h2>
        {lead && <p class="lead">{lead}</p>}
      </div>
      <div class="faqs__list">
        {items.map((it) => (
          <details class="faq">
            <summary><span>{it.q}</span><span class="faq__icon" aria-hidden="true"></span></summary>
            <div class="faq__a" set:html={it.a} />
          </details>
        ))}
      </div>
    </div>
  </section>
)}
